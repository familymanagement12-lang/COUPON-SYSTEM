PORT=3000
NODE_ENV=development

# Comma-separated list of frontend origins
FRONTEND_URL=http://localhost:5173
STUDENT_EMAIL_DOMAIN=mccarthyhillschool.edu.gh

# Set these explicitly before running create-super-admin.js
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Database Configuration
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=school_wallet_db
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false

# JWT Configuration
JWT_SECRET=
JWT_EXPIRATION=7d
REFRESH_TOKEN_EXPIRATION=30d

# MTN Mobile Money Integration
MTN_API_KEY=
MTN_PRIMARY_KEY=
MTN_SECONDARY_KEY=
MTN_SUBSCRIPTION_KEY=
MTN_USER_ID=

# Telecel Cash Integration
TELECEL_API_KEY=
TELECEL_MERCHANT_ID=
TELECEL_MERCHANT_KEY=

# AirtelTigo Cash Integration
AIRTELTIGO_API_KEY=
AIRTELTIGO_CLIENT_ID=
AIRTELTIGO_CLIENT_SECRET=

# Paystack Integration
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_ENVIRONMENT=test

# Payment return URL (the webhook is configured in the Paystack dashboard)
PAYMENT_RETURN_URL=http://localhost:5173/topup

# SMS Gateway
SMS_PROVIDER=
SMS_API_KEY=

# Email Configuration
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASSWORD=

# QR Code Configuration
QR_CODE_SECRET=
